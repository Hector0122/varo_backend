generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  transactions Transaction[]
  financialObjectives FinancialObjective[]
  categories   Category[]
  recurringTransactions RecurringTransaction[]
}

model Transaction {
  id       String   @id @default(uuid())
  userId   String
  amount   Decimal
  type     String
  category String
  note     String?
  date     DateTime

  user           User            @relation(fields: [userId], references: [id])
  objectiveEntry ObjectiveEntry?
}

model Category {
  id     String @id @default(uuid())
  userId String
  name   String
  type   String // 'INCOME', 'EXPENSE', or 'BOTH'

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, name])
}

enum FinancialObjectiveType {
  SAVING_GOAL
  DEBT_PAYOFF
}

model FinancialObjective {
  id               String                 @id @default(uuid())
  userId           String
  type             FinancialObjectiveType
  name             String
  targetAmount     Decimal
  currentAmount    Decimal                @default(0)
  savingAllocation Float? // SAVING_GOAL only
  dueDate          DateTime? // DEBT_PAYOFF only
  statementDay     Int? // DEBT_PAYOFF only
  createdAt        DateTime               @default(now())

  user      User                        @relation(fields: [userId], references: [id])
  entries   ObjectiveEntry[]
  snapshots ObjectiveForecastSnapshot[]
}

model ObjectiveEntry {
  id           String   @id @default(uuid())
  objectiveId  String
  amount       Decimal
  type         String // 'ADD' | 'WITHDRAW' | 'PAYMENT' | 'INCREASE'
  note         String?
  installments Int      @default(1) // DEBT_PAYOFF INCREASE only
  purchaseDate DateTime @default(now())
  createdAt    DateTime @default(now())

  objective FinancialObjective @relation(fields: [objectiveId], references: [id])

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
}

model ObjectiveForecastSnapshot {
  id              String   @id @default(uuid())
  objectiveId     String
  projectedDate   DateTime
  monthlyRate     Decimal
  confidenceScore Float
  createdAt       DateTime @default(now())

  objective FinancialObjective @relation(fields: [objectiveId], references: [id])
}

model RecurringTransaction {
  id              String   @id @default(uuid())
  userId          String
  amount          Decimal
  type            String   // 'INCOME' or 'EXPENSE'
  category        String
  note            String?
  frequency       String   // 'DAILY', 'WEEKLY', 'BIWEEKLY', 'MONTHLY', 'YEARLY'
  startDate       DateTime
  endDate         DateTime?
  lastGeneratedAt DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
