generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  transactions Transaction[]
  goals        Goal[]
  categories   Category[]
  debts Debt[]
  recurringTransactions RecurringTransaction[]
}

model Transaction {
  id       String   @id @default(uuid())
  userId   String
  amount   Decimal
  type     String
  category String
  note     String?
  date     DateTime

  user User @relation(fields: [userId], references: [id])
}

model Category {
  id     String @id @default(uuid())
  userId String
  name   String
  type   String // 'INCOME', 'EXPENSE', or 'BOTH'

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, name])
}

model Goal {
  id              String   @id @default(uuid())
  userId          String
  name            String
  targetAmount    Decimal
  currentAmount   Decimal @default(0)
  savingAllocation Float   @default(100)
  createdAt       DateTime @default(now())

  user     User               @relation(fields: [userId], references: [id])
  snapshots ForecastSnapshot[]
}

model ForecastSnapshot {
  id              String   @id @default(uuid())
  goalId          String
  projectedDate   DateTime
  monthlySaving   Decimal
  confidenceScore Float
  createdAt       DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id])
}

model Debt {
  id            String   @id @default(uuid())
  userId        String
  name          String
  totalAmount   Decimal
  currentAmount Decimal  @default(0)
  dueDate       DateTime?
  createdAt     DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id])
  payments DebtPayment[]
}

model DebtPayment {
  id            String   @id @default(uuid())
  debtId        String
  amount        Decimal
  type          String   // 'PAYMENT' or 'INCREASE'
  note          String?
  installments  Int      @default(1)
  purchaseDate  DateTime @default(now())
  createdAt     DateTime @default(now())

  debt Debt @relation(fields: [debtId], references: [id])
}

model RecurringTransaction {
  id              String   @id @default(uuid())
  userId          String
  amount          Decimal
  type            String   // 'INCOME' or 'EXPENSE'
  category        String
  note            String?
  frequency       String   // 'DAILY', 'WEEKLY', 'BIWEEKLY', 'MONTHLY', 'YEARLY'
  startDate       DateTime
  endDate         DateTime?
  lastGeneratedAt DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
